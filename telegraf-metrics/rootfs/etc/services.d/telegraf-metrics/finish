#!/usr/bin/env bashio
# ==============================================================================
# Take down the S6 supervision tree when telegraf-metrics fails
# ==============================================================================
if [[ "$1" -ne 0 ]] && [[ "$1" -ne 256 ]]; then
  bashio::log.warning "Telegraf metrics failed, halting add-on"
  /run/s6/basedir/bin/halt
fi

bashio::log.info "Telegraf metrics stopped, restarting..."