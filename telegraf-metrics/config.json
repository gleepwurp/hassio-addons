{
    "name": "Telegraf Metrics",
    "version": "1.0.0",
    "slug": "telegraf-metrics",
    "description": "Collect and process Telegraf metrics from MQTT topics",
    "url": "https://github.com/gleepwurp/hassio-addons/tree/master/telegraf-metrics",
    "startup": "application",
    "init": false,
    "arch": [
        "aarch64",
        "amd64",
        "armhf",
        "armv7",
        "i386"
    ],
    "boot": "auto",
    "hassio_api": true,
    "hassio_role": "default",
    "mqtt": true,
    "options": {
        "log_level": "info",
        "mqtt": {
            "broker": "core-mosquitto",
            "port": 1883,
            "username": "",
            "password": "",
            "client_id": "telegraf-metrics-addon"
        },
        "servers": [
            {
                "hostname": "server1",
                "friendly_name": "Main Server",
                "areas": ["cpu", "memory", "disk", "network"]
            }
        ],
        "update_interval": 60
    },
    "schema": {
        "log_level": "list(trace|debug|info|notice|warning|error|fatal)",
        "mqtt": {
            "broker": "str",
            "port": "port",
            "username": "str?",
            "password": "password?",
            "client_id": "str?"
        },
        "servers": [
            {
                "hostname": "str",
                "friendly_name": "str",
                "areas": ["str"]
            }
        ],
        "update_interval": "int(10,3600)"
    }
}